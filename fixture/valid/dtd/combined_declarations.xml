<!DOCTYPE catalog [
  <!ELEMENT catalog (entry|note|anything)+>
  <!ELEMENT entry (title,meta*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST entry id ID #REQUIRED status (new|old) "new" link IDREF #IMPLIED>
  <!ATTLIST meta key CDATA #REQUIRED>
  <!ELEMENT note (#PCDATA|emphasis)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT anything ANY>
]>
<catalog>
  <entry id="e1"><title>One</title><meta key="x"/></entry>
  <entry id="e2" status="old" link="e1"><title>Two</title><meta key="y"/><meta key="z"/></entry>
  <note>before <emphasis>inside</emphasis> after</note>
  <anything>text<emphasis>free</emphasis><!--comment--><?process data?></anything>
</catalog>
